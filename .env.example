# PostgreSQL connection string (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL="postgresql://user:password@host:5432/schoolbot"

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=""

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=""

# Secret for Telegram webhook verification (any random string, 1-256 chars).
# Telegram sends it in the X-Telegram-Bot-Api-Secret-Token header;
# requests without a matching secret are rejected with 401.
TELEGRAM_WEBHOOK_SECRET=""

# Comma-separated Telegram user IDs allowed to approve homework, e.g. "123456789,987654321"
ADMIN_TELEGRAM_IDS=""
